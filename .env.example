# Public routes need no environment variables. The admin route requires the
# server-only settings below and fails closed when they are absent.
# Never add real credentials or administrator identities to this file.

# Admin Access values are server-only. Without all three, /admin fails closed.
# Set these in .dev.vars for local integration or as deployed Worker secrets.
# ADMIN_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# ADMIN_ACCESS_AUD=your-admin-application-audience
# ADMIN_IDENTITY_PAIRS=[{"email":"owner@example.invalid","sub":"synthetic-user-id"}]
