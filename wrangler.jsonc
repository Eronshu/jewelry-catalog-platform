{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jewelry-catalog-platform",
  "compatibility_date": "2026-09-29",
  "main": "./workers/app.ts",
  "assets": { "run_worker_first": ["/admin", "/admin.data", "/admin/*"] },
  "cache": { "enabled": true },
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "jewelry-catalog-images-local",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jewelry-catalog-local",
      "migrations_dir": "migrations",
      "migrations_table": "catalog_migrations",
    },
  ],
}
